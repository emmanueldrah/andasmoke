{
  "name": "anda-smoke-hub-pos",
  "version": "1.1.4602",
  "author": "Anda C Smoke Hub",
  "description": "Point of sale for Anda C Smoke Hub: till, stock, staff and reports, on this machine and in sync with the website.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "node scripts/build-api.mjs",
    "build:check": "tsc --noEmit && npm run build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pos:desktop": "npm run build && electron electron/main.cjs",
    "pos:desktop:dev": "electron electron/main.cjs --dev-url=http://127.0.0.1:3000",
    "pos:desktop:package": "node scripts/check-windows-signing.mjs && npm run build && electron-builder --win nsis",
    "pos:desktop:publish": "node scripts/publish-desktop.mjs",
    "spike": "node tests/spike-desktop.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.38.3",
    "electron-updater": "^6.6.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.53.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.30.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "gh.anda.smokehub.pos",
    "productName": "Anda C Smoke Hub POS",
    "directories": {
      "output": "release-${version}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://andasmoke.vercel.app/updates/win"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "public/brand-mark.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/brand-mark.ico",
      "uninstallerIcon": "public/brand-mark.ico",
      "installerHeader": "public/brand-mark-header.bmp"
    }
  }
}
